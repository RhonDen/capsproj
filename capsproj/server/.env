# Server environment
# IMPORTANT: Set JWT_SECRET to a strong random value in production.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Database configuration
DB_DIALECT=sqlite

# If using MySQL, set:
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=appointease
# DB_USER=root
# DB_PASSWORD=

# CORS
FRONTEND_URL=http://localhost:5173

